# Copie para .env.local e preencha. Nunca commite valores reais.

# URL base do Strapi (sem /api no final)
NEXT_PUBLIC_STRAPI_URL=https://seu-strapi.exemplo.com

# Token de API somente leitura do Strapi (usado apenas no build)
STRAPI_API_TOKEN=coloque_o_token_aqui

# Endpoint do formulário de contato (ex.: https://formspree.io/f/SEU_ID)
NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/SEU_ID
